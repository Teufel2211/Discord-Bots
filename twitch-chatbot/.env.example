# Twitch-Konto, mit dem der Bot sich im Chat anmeldet
BOT_USERNAME=dein_bot_account
# Kanal, in dessen Chat der Bot schreiben soll (ohne #)
TWITCH_CHANNEL=dein_twitch_kanal
# OAuth-Zugriffstoken für den Bot-Account; Format: oauth:...
TWITCH_OAUTH=oauth:DEIN_TOKEN_HIER
# Für !timer: Client-ID aus der Twitch Developer Console
TWITCH_CLIENT_ID=deine_twitch_client_id
# Twitch-ID des Kanals, in dem der Timer angepinnt wird
TWITCH_BROADCASTER_ID=deine_broadcaster_id
# Optional, falls der Bot-Login nicht automatisch aufgelöst werden soll
TWITCH_BOT_USER_ID=
TWITCH_MODERATOR_ID=
# Optional: zusätzliche Diagnoseausgaben für !timer (niemals den Token ausgeben)
DEBUG_TIMER=false

# Giveaway-Dashboard auf Vercel
GIVEAWAY_API_URL=https://DEIN-PROJEKT.vercel.app/api/giveaway
GIVEAWAY_BOT_SECRET=ein-langes-geheimes-bot-passwort
WATCHTIME_API_URL=https://DEIN-PROJEKT.vercel.app/api/watchtime
