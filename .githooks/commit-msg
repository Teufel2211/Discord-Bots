#!/bin/bash
msgfile="$1"
first_line="$(head -n 1 "$msgfile")"

if printf '%s' "$first_line" | grep -qiE '^(bww|current|twitch-chatbot)(:|[[:space:]])'; then
  exit 0
fi

echo "ERROR: Git-Commit wurde abgelehnt."
echo "Commit-Message muss mit Bot-Abkürzung beginnen."
echo "Erlaubte Formate: 'bww: <beschreibung>', 'current: <beschreibung>', 'twitch-chatbot: <beschreibung>'."
exit 1
